# Copy this file to .env and change the values

# PostgreSQL connection (SQLAlchemy URL)
DATABASE_URL=postgresql+psycopg2://fitness:fitness@localhost:5432/fitness_db

# Long random string used to sign login tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string

# How long a login lasts, in minutes (1440 = 24 hours)
JWT_EXPIRE_MINUTES=1440

# Frontend URLs allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI assistant (optional). With one of these keys the assistant answers any question with a real AI model,
# using the user's FitPlate data. Without a key it uses the built-in offline assistant.
#   Groq (free, no card):          https://console.groq.com/keys
#   Google Gemini (free, can search Google): https://aistudio.google.com/apikey
#   Anthropic Claude:              https://console.anthropic.com
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: choose the provider when several keys are set (groq, gemini or anthropic), or change the model
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
